# Power Tech Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── JWT ───────────────────────────────────────────────────────────────────────
# A long, random secret string for signing user tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-random-jwt-secret-here

# ─── Admin ─────────────────────────────────────────────────────────────────────
# A secret key for the admin panel.
# Choose a strong random string — this is like a password for your admin panel.
ADMIN_API_KEY=your-secret-admin-key-here

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ─── CORS ──────────────────────────────────────────────────────────────────────
# URL of your frontend (GitHub Pages URL). Use * for development.
# Example: https://yourusername.github.io
FRONTEND_URL=https://yourusername.github.io
